APP_USERNAME=admin
APP_PASSWORD=change_me_secret_123
SESSION_SECRET=super-secret-key-change-in-production-12345
YOUTUBE_API_KEY=AIzaSyYourApiKeyHere
DATA_DIR=./data
DEFAULT_CHECK_INTERVAL_HOURS=6

# Serial download queue — seconds to wait between consecutive downloads
# Prevents bot detection from parallel requests on datacenter IPs.
DOWNLOAD_PAUSE=20

# Timeout (seconds) for yt-dlp download and ffmpeg transcode subprocesses.
# Increase for very long videos (>2h).
DOWNLOAD_TIMEOUT=1800
TRANSCODE_TIMEOUT=3600

# IMPORTANT: cookies.txt is REQUIRED for datacenter IPs (Coolify / VPS).
# Place cookies.txt inside the DATA_DIR folder.
# Without it, YouTube will block downloads with "Sign in to confirm you're not a bot".
# Export cookies from a logged-in browser using a browser extension (e.g. "Get cookies.txt").
